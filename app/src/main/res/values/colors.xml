    <!--
        Cubiq window chrome (phase 1 of the Cubiq UI port).
        Cubiq-Launcher's themes.xml pins android:statusBarColor to a literal #141414 rather than
        to its content surface, so the system bars sit one step darker than the app and the whole
        thing reads as edge-to-edge. Ported as dedicated tokens instead of reusing miuix_surface
        (#1E1E20) so the chrome can be tuned independently of the content.
        cubiq_fullscreen_background mirrors Cubiq's AppTheme.Fullscreen (#000000 behind the game).
    -->
    <color name="cubiq_chrome">#FF141414</color>
    <color name="cubiq_chrome_transparent">#00000000</color>
    <color name="cubiq_fullscreen_background">#FF000000</color>

